# 4. Tall Bar Plot: Life Expectancy by Country in 2007
bar_plot <- gapminder %>%
filter(year == 2007) %>%
arrange(desc(lifeExp)) %>%
mutate(country = factor(country, levels = unique(country))) %>%
ggplot(aes(x = country, y = lifeExp, fill = continent)) +
geom_bar(stat = "identity", width = 0.8, alpha = 1) +  # Fully solid bars
scale_fill_manual(values = vibrant_colors) +
coord_flip() +  # Flip for better readability
labs(title = "Life Expectancy by Country in 2007",
x = "Country",
y = "Life Expectancy (years)") +
theme_minimal() +
theme(legend.position = "none",
axis.text.y = element_text(size = 6))  # Smaller text for readability
# Save tall bar plot as PDF
ggsave("bar_plot_lifeExp_2007.pdf", plot = bar_plot, width = 6, height = 10, device = "pdf")
print("Tall bar plot saved as Illustrator-friendly PDF.")
# 4. Compact Bar Plot: Top 5 Countries per Continent (Life Expectancy in 2007)
top5_countries <- gapminder %>%
filter(year == 2007) %>%
group_by(continent) %>%
top_n(5, lifeExp) %>%
arrange(continent, desc(lifeExp)) %>%
mutate(country = factor(country, levels = unique(country)))  # Keep country order
bar_plot <- ggplot(top5_countries, aes(x = country, y = lifeExp, fill = continent)) +
geom_bar(stat = "identity", width = 0.8, alpha = 1) +  # Solid bars
scale_fill_manual(values = vibrant_colors) +
coord_flip() +  # Flip for better readability
labs(title = "Top 5 Countries by Life Expectancy (2007)",
x = "Country",
y = "Life Expectancy (years)") +
theme_minimal() +
theme(legend.position = "none",
axis.text.y = element_text(size = 10))  # Readable labels
# Save the compact bar plot as a PDF
ggsave("bar_plot_top5_lifeExp_2007.pdf", plot = bar_plot, width = 7, height = 6, device = "pdf")
print("Compact bar plot saved as Illustrator-friendly PDF.")
# Select top 2 countries per continent by life expectancy in 2007
top2_countries <- gapminder %>%
filter(year == 2007) %>%
group_by(continent) %>%
top_n(2, lifeExp) %>%
arrange(desc(lifeExp)) %>%
ungroup()
# Generate dot plot
dot_plot <- ggplot(top2_countries, aes(x = lifeExp, y = reorder(country, lifeExp),
color = continent, size = gdpPercap)) +
geom_point(alpha = 0.8) +
scale_color_manual(values = vibrant_colors) +
scale_size_continuous(range = c(3, 10)) +  # Adjust dot size for visibility
labs(title = "Top 2 Countries by Life Expectancy (2007)",
x = "Life Expectancy (years)",
y = "Country",
size = "GDP per Capita") +
theme_minimal() +
theme(legend.position = "right")
# Save as a PDF to match previous plots
ggsave("dot_plot_top2_lifeExp_2007.pdf", plot = dot_plot, width = 6, height = 8, device = "pdf")
print("Dot plot saved as Illustrator-friendly PDF.")
