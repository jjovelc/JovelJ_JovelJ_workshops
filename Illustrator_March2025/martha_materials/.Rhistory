# Function to process and plot each group (litter or dust)
process_group <- function(data, metadata, prefix, bar_color_cage, bar_color_floor) {
# Subset metadata for the specific group (prefix)
meta <- metadata[metadata$group == prefix, ]
data_cpm <- data[, rownames(meta)]
# Add housing information for each sample and reshape the data
sample_housing <- meta[rownames(meta), "housing"]
data_long <- as.data.frame(t(data_cpm))
data_long$Housing <- sample_housing
# Calculate mean and standard deviation for each taxa and housing type
summary_data <- data_long %>%
group_by(Housing) %>%
summarize(across(everything(), list(mean = mean, sd = sd)), .groups = "drop") %>%
pivot_longer(-Housing, names_to = c("Taxa", ".value"), names_sep = "_")
# Plot paired horizontal bar plot for each taxa
plot <- ggplot(summary_data, aes(y = Taxa, x = mean, fill = Housing)) +
geom_bar(stat = "identity", position = "dodge") +
geom_errorbar(aes(xmin = mean - sd, xmax = mean + sd),
position = position_dodge(0.9), width = 0.25) +
scale_fill_manual(values = c("cage" = bar_color_cage, "floor" = bar_color_floor)) +
labs(y = "Taxa", x = "Mean Abundance (CPM)", title = paste(prefix, "Group: Cage vs Floor")) +
theme_minimal() +
theme(axis.text.y = element_text(angle = 0, hjust = 1))
# Save the plot
filename <- paste0(prefix, "_taxa_horizontal_barplot_cage_vs_floor.png")
ggsave(filename = filename, plot = plot, width = 12, height = 15, units = "in", dpi = 300)
}
