theme(legend.position = "top",
axis.text = element_blank(),
axis.ticks = element_blank(),
axis.title = element_blank(),
plot.margin = unit(c(0, 0, 0, 0), "cm"))
# Create dot plot with adjusted p-values
main_plot <- ggplot(long_data, aes(x = Sample, y = Taxa)) +
geom_point(aes(size = Abundance, color = neg_log10_adj_pvalue)) +
scale_size_continuous(range = c(1, 10)) +
scale_color_gradient2(low =color1, mid = color2, high = color3, midpoint = median(long_data$neg_log10_adj_pvalue, na.rm = TRUE), na.value = "gray", name = "-log10(adj p-value)") +
theme_bw() +
labs(title = "",
x = "Sample", y = "Taxa", size = "Abundance", color = "-log10(adj p-value)") +
theme(axis.text.x = element_text(angle = 90, vjust = 0.5, hjust = 1),
legend.position = "bottom")
# Combine the plots
combined_plot <- plot_grid(housing_plot, main_plot, ncol = 1, align = "v", rel_heights = c(0.065, 1))
# Save the combined plot
filename <- paste0(prefix, "_taxa_dotplot_with_adjusted_pvalues.png")
ggsave(filename = filename, plot = combined_plot, width = 10, height = 15, units = "in", dpi = 300)
}
process_group(data_10up_cpm, metadata, "litter",  "black",  "green", "red")
process_group <- function(data, metadata, prefix, color1, color2, color3){
# Subset metadata for prefix group
meta <- paste0("meta_", prefix)
meta <- metadata[metadata$group == prefix, ]
data_cpm <- data_10up_cpm[, rownames(meta)]
print(data_cpm)
head(data_cpm)
data <- log(data_cpm)
data$Taxa <- rownames(data)
# Reshape data to long format
long_data <- melt(data, id.vars = "Taxa", variable.name = "Sample", value.name = "Abundance")
# Add 'Sample' column to metadata
meta$Sample <- rownames(meta)
# Merge 'housing' into long_data_litter
long_data <- merge(long_data, meta[, c("Sample", "housing")], by = "Sample", all.x = TRUE)
# Perform Wilcoxon tests and adjust p-values one by one
taxa_pvalues <- data.frame(Taxa = rownames(data_cpm), adj_pvalue = NA)
for (taxon in rownames(data_cpm)) {
counts <- as.numeric(data_cpm[taxon, ])
housing_info <- meta$housing
# Calculate p-value for each taxon and adjust individually
p_val <- wilcox.test(counts ~ housing_info)$p.value
p_adj <- p.adjust(p_val, method = "BH")  # Adjust each p-value individually
# Store adjusted p-value in the data frame
taxa_pvalues[taxa_pvalues$Taxa == taxon, "adj_pvalue"] <- p_adj
}
# Save the adjusted p-values to a file
filename <- paste0(prefix, "_adjusted_p_values.txt")
write.table(taxa_pvalues, file = filename, sep = "\t", row.names = FALSE, quote = FALSE)
# Merge adjusted p-values into long_data_litter
long_data <- merge(long_data, taxa_pvalues, by = "Taxa", all.x = TRUE)
# Calculate -log10 of adjusted p-values
long_data$neg_log10_adj_pvalue <- -log10(long_data$adj_pvalue)
max_finite <- max(long_data$neg_log10_adj_pvalue[is.finite(long_data$neg_log10_adj_pvalue)], na.rm = TRUE)
long_data$neg_log10_adj_pvalue[is.infinite(long_data$neg_log10_adj_pvalue)] <- max_finite + 1
# Define sample order
sample_order <- colnames(data_cpm)
long_data$Sample <- factor(long_data$Sample, levels = sample_order)
meta$Sample <- factor(meta$Sample, levels = sample_order)
# Create top tile bar for housing information
top_tiles <- unique(long_data[, c("Sample", "housing")])
top_tiles$Sample <- factor(top_tiles$Sample, levels = sample_order)
housing_plot <- ggplot(top_tiles, aes(x = Sample, y = 1, fill = housing)) +
geom_tile() +
scale_fill_manual(values = c("cage" = "salmon", "floor" = "turquoise"), name = "Housing") +
theme_bw() +
theme(legend.position = "top",
axis.text = element_blank(),
axis.ticks = element_blank(),
axis.title = element_blank(),
plot.margin = unit(c(0, 0, 0, 0), "cm"))
# Create dot plot with adjusted p-values
main_plot <- ggplot(long_data, aes(x = Sample, y = Taxa)) +
geom_point(aes(size = Abundance, color = neg_log10_adj_pvalue)) +
scale_size_continuous(range = c(1, 10)) +
scale_color_gradient2(low =color1, mid = color2, high = color3, midpoint = median(long_data$neg_log10_adj_pvalue, na.rm = TRUE), na.value = "gray", name = "-log10(adj p-value)") +
theme_bw() +
labs(title = "",
x = "Sample", y = "Taxa", size = "Abundance", color = "-log10(adj p-value)") +
theme(axis.text.x = element_text(angle = 90, vjust = 0.5, hjust = 1),
legend.position = "bottom")
# Combine the plots
combined_plot <- plot_grid(housing_plot, main_plot, ncol = 1, align = "v", rel_heights = c(0.065, 1))
# Save the combined plot
filename <- paste0(prefix, "_taxa_dotplot_with_adjusted_pvalues.png")
ggsave(filename = filename, plot = combined_plot, width = 10, height = 15, units = "in", dpi = 300)
}
process_group(data_10up_cpm, metadata, "litter",  "black",  "green", "red")
