process_group <- function(data, metadata, prefix, bar_color_cage, bar_color_floor) {
# Subset metadata for the specific group (prefix)
meta <- metadata[metadata$group == prefix, ]
data_cpm <- data[, rownames(meta)]
# Melt data for ggplot
data_melted <- melt(as.data.frame(data_cpm), variable.name = "Sample", value.name = "Abundance")
data_melted$Housing <- meta[data_melted$Sample, "housing"]
data_melted$Taxa <- rownames(data_melted)
# Calculate average and standard deviation for each taxa and housing type
summary_data <- data_melted %>%
group_by(Taxa, Housing) %>%
summarize(mean_abundance = mean(Abundance), sd_abundance = sd(Abundance), .groups = "drop")
# Plot paired bar plot for each taxa
plot <- ggplot(summary_data, aes(x = Taxa, y = mean_abundance, fill = Housing)) +
geom_bar(stat = "identity", position = "dodge") +
geom_errorbar(aes(ymin = mean_abundance - sd_abundance, ymax = mean_abundance + sd_abundance),
position = position_dodge(0.9), width = 0.25) +
scale_fill_manual(values = c("cage" = bar_color_cage, "floor" = bar_color_floor)) +
labs(x = "Taxa", y = "Mean Abundance (CPM)", title = paste(prefix, "Group: Cage vs Floor")) +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
# Save the plot
filename <- paste0(prefix, "_taxa_barplot_cage_vs_floor.png")
ggsave(filename = filename, plot = plot, width = 10, height = 6, units = "in", dpi = 300)
}
